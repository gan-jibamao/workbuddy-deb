<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GroupName</key>
	<string>wheel</string>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.jkgl.workbuddy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/bin/sh</string>
		<string>/var/jb/usr/share/workbuddy/wbstart</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/workbuddy/server.log</string>
	<key>StandardOutPath</key>
	<string>/var/workbuddy/server.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>root</string>
</dict>
</plist>
